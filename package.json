{
  "name": "urdf-ops",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config config/vite.config.ts",
    "build": "vite build --config config/vite.config.ts",
    "lint": "eslint --config config/eslint.config.js .",
    "test": "vitest run --config config/vite.config.ts",
    "typecheck": "tsc -b --pretty false config/tsconfig.json",
    "setup": "node tools/scripts/setup.js",
    "start": "node tools/scripts/start-ops.js",
    "test:backend": "sh -c 'if [ ! -x .venv-lerobot/bin/python3 ]; then echo \"Missing .venv-lerobot/bin/python3. Run npm run setup first.\" >&2; exit 1; fi; if [ \"$#\" -gt 0 ]; then .venv-lerobot/bin/python3 -m pytest \"$@\"; else .venv-lerobot/bin/python3 -m pytest backend/tests/test_training_models.py backend/tests/test_compute_factory.py backend/tests/test_training_cloud_control.py backend/tests/test_keypoint_observations.py; fi' --",
    "backend": "python3 -m uvicorn backend.app:app --host 127.0.0.1 --port 8001"
  },
  "bin": {
    "urdf-ops": "./tools/scripts/cli.js"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@tanstack/react-query": "^5.83.0",
    "apache-arrow": "^21.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i-love-urdf": "git+https://github.com/urdf-studio/i-love-urdf-unprod.git#10ab4f8d4bf7ae0f75ae5cc8d5a389122c1eabf4",
    "inquirer": "^13.2.0",
    "js-yaml": "^4.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.462.0",
    "parquet-wasm": "^0.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "reactflow": "^11.11.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.160.1",
    "three-stdlib": "^2.36.0",
    "urdf-loader": "^0.12.6",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jscpd": "^4.0.7",
    "jsdom": "^29.0.0",
    "lovable-tagger": "^1.1.11",
    "playwright": "^1.58.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^6.0.3",
    "vitest": "^4.0.17"
  }
}
